{
  "expo": {
    "name": "Ledger",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ledger-icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ledger-icon.png",
      "bundleIdentifier": "com.massaotani.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#204B4C",
        "foregroundImage": "./assets/images/ledger-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ledger-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6cdb5e1b-8bb6-4280-baab-d32a41110ae9"
      }
    },
    "owner": "massaotani"
  }
}
