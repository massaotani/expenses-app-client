{
  "expo": {
    "name": "Ledger",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logos/LedgerApp_Logo_Dark.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logos/LedgerApp_Logo_Dark.png",
      "bundleIdentifier": "com.massaotani.ledgerapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#204B4C",
        "foregroundImage": "./assets/images/logos/LedgerApp_Logo_Dark.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.massaotani.ledgerapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logos/LedgerApp_Logo_Light.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-localization",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1081635959519-e3g6vbna6eb51mc6idutgtuaj3hfalln"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      [
        "expo-dynamic-app-icon",
        {
          "light": {
            "image": "./assets/images/logos/LedgerApp_Logo_Light.png"
          },
          "dark": {
            "image": "./assets/images/logos/LedgerApp_Logo_Dark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93516eb6-43b9-455b-b9a8-eccc0b429a77"
      }
    },
    "owner": "ledgerapp",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/93516eb6-43b9-455b-b9a8-eccc0b429a77"
    }
  }
}