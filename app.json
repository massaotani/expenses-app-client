{
  "expo": {
    "name": "Ledger",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ledger-icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ledger-icon.png",
      "bundleIdentifier": "com.massaotani.ledgerapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#204B4C",
        "foregroundImage": "./assets/images/ledger-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.massaotani.ledgerapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ledger-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-localization",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1081635959519-e3g6vbna6eb51mc6idutgtuaj3hfalln"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "547b8ce1-78b8-4e58-9b23-6983b1aa820a"
      }
    },
    "owner": "massaotani"
  }
}
